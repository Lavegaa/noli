datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum ConsentStatus {
  not_required
  pending
  granted
}

model Account {
  id               String          @id @default(uuid())
  firebaseUid      String          @unique
  linkedProviders  String[]
  birthDate        DateTime?       @db.Date
  consentStatus    ConsentStatus   @default(not_required)
  storageSlots     Int             @default(6)
  shards           Int             @default(0)
  pityCounter      Int             @default(0)
  uploadRestricted Boolean         @default(false)
  createdAt        DateTime        @default(now())
  clickers         Clicker[]
  inventoryItems   InventoryItem[]
  shareCodes       ShareCode[]
  friendshipsA     Friendship[]    @relation("FriendA")
  friendshipsB     Friendship[]    @relation("FriendB")
  playRecords      PlayRecord[]
  clickerStats     ClickerStat[]
  news             NewsItem[]
  dailyQuests      DailyQuest[]
}

enum InventorySource {
  created
  received
  original
}

model Clicker {
  id               String          @id @default(uuid())
  creatorId        String
  name             String
  version          Int             @default(1)
  idleKey          String
  pressedKey       String?
  specJson         Json
  faceDetected     Boolean         @default(false)
  hidden           Boolean         @default(false)
  deletedByCreator Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  creator          Account         @relation(fields: [creatorId], references: [id])
  inventoryItems   InventoryItem[]
  shareCodes       ShareCode[]
  playRecords      PlayRecord[]
  stats            ClickerStat[]

  @@index([creatorId])
}

model InventoryItem {
  id              String          @id @default(uuid())
  accountId       String
  clickerId       String
  source          InventorySource
  receivedVersion Int?
  /// Switch 모델은 Task 7에서 생긴다. 그때까지는 FK 없이 id만 보관한다.
  soundSwitchId   String?
  effectSwitchId  String?
  createdAt       DateTime        @default(now())
  account         Account         @relation(fields: [accountId], references: [id])
  clicker         Clicker         @relation(fields: [clickerId], references: [id])

  @@unique([accountId, clickerId])
}

model ShareCode {
  code        String   @id
  clickerId   String
  creatorId   String
  allowFriend Boolean
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  clicker     Clicker  @relation(fields: [clickerId], references: [id])
  creator     Account  @relation(fields: [creatorId], references: [id])

  @@index([clickerId])
}

/// accountA < accountB 로 정렬해 저장한다(쌍마다 한 행).
model Friendship {
  accountA  String
  accountB  String
  createdAt DateTime @default(now())
  a         Account  @relation("FriendA", fields: [accountA], references: [id])
  b         Account  @relation("FriendB", fields: [accountB], references: [id])

  @@id([accountA, accountB])
  @@index([accountB])
}

enum PlayMode {
  free
  timed10
}

model PlayRecord {
  id         String   @id @default(uuid())
  accountId  String
  clickerId  String
  mode       PlayMode
  score      Int
  maxCombo   Int
  taps       Int
  durationMs Int
  playedAt   DateTime
  account    Account  @relation(fields: [accountId], references: [id])
  clicker    Clicker  @relation(fields: [clickerId], references: [id])

  @@index([accountId, playedAt])
  @@index([clickerId, playedAt])
}

model ClickerStat {
  accountId String
  clickerId String
  bestScore Int
  bestCombo Int
  totalTaps Int
  account   Account @relation(fields: [accountId], references: [id])
  clicker   Clicker @relation(fields: [clickerId], references: [id])

  @@id([accountId, clickerId])
}

enum NewsType {
  friend_record
  received
}

model NewsItem {
  id          String    @id @default(uuid())
  recipientId String
  type        NewsType
  payload     Json
  createdAt   DateTime  @default(now())
  readAt      DateTime?
  recipient   Account   @relation(fields: [recipientId], references: [id])

  @@index([recipientId, createdAt])
}

model DailyQuest {
  accountId         String
  /// KST `YYYY-MM-DD`
  day               String
  questKey          String
  target            Int
  progress          Int       @default(0)
  reward            Int
  claimedAt         DateTime?
  /// friend_play가 이미 센 클릭커. 같은 클릭커를 두 번 세지 않는다.
  countedClickerIds String[]  @default([])
  account           Account   @relation(fields: [accountId], references: [id])

  @@id([accountId, day, questKey])
}
