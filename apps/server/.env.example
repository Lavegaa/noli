# 로컬 개발 DB (docker compose up -d db)
DATABASE_URL=postgresql://noli:noli@localhost:5432/noli
PORT=3000

# Firebase Admin (ADC 또는 서비스 계정 경로)
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=

# S3 호환 오브젝트 스토리지
S3_ENDPOINT=
S3_REGION=ap-northeast-2
S3_BUCKET=noli-clickers
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# 공유 링크 호스트 (https://<SHARE_HOST>/s/<code>)
SHARE_HOST=noli.example.com
